<Project>

  <!-- Herda as configurações da raiz. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Configurações apenas para projetos publicados no NuGet. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Metadados do pacote NuGet. Versões 0.x: API ainda instável (SemVer). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Eduardo Fritsch Silva</Authors>
    <Copyright>Copyright 2026 Eduardo Fritsch Silva</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Grogww/Anonimizador</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Grogww/Anonimizador</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Anonimizador de dados pessoais brasileiros para .NET: substitui CPF, CNPJ, telefone, e-mail e nome em resultados de banco de dados por valores fictícios válidos e determinísticos, offline. CPF, CNPJ e telefone usam FPE FF1 (NIST SP 800-38G) sem colisões, preservando as junções entre tabelas.</Description>
    <PackageTags>anonimizador;anonimizacao;dotnet;pseudonimizacao;lgpd;cpf;cnpj;fpe;ff1;privacidade;mcp;adonet</PackageTags>

    <!-- SourceLink (embutido no SDK): permite depurar o código-fonte a partir do pacote. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- README exibido na página do pacote no NuGet. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Controle da API pública: toda mudança precisa ser registrada em PublicAPI.*.txt. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
