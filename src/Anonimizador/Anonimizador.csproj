<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Anonimizador</RootNamespace>
  </PropertyGroup>

  <!-- Dicionários embutidos (nomes, provedores de e-mail, domínios), lidos por EmbeddedLists. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.txt" LogicalName="Anonimizador.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anonimizador.Tests" />
    <InternalsVisibleTo Include="Anonimizador.Benchmarks" />
  </ItemGroup>

</Project>
